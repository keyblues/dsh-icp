{
  "name": "dsh-icp-query",
  "version": "2.0.1",
  "description": "DeepSeek Harness (DSH) plugin: MIIT ICP filing lookup for websites, apps, mini programs, quick apps and the four violation blacklists. DSH 插件：工信部 ICP 备案查询（网站、APP、小程序、快应用及四类违法违规黑名单）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "icp",
    "miit",
    "beian",
    "icp-filing",
    "website-filing",
    "app-filing",
    "blacklist",
    "备案查询",
    "ICP备案",
    "工信部"
  ],
  "license": "MIT",
  "author": "keyblues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyblues/dsh-icp.git"
  },
  "homepage": "https://github.com/keyblues/dsh-icp#readme",
  "bugs": {
    "url": "https://github.com/keyblues/dsh-icp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/contract.mjs && node test/client.mjs && node --unhandled-rejections=strict test/stability.mjs",
    "prepublishOnly": "npm test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "test/**/*.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
